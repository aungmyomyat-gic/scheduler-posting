  "healthResponseSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "const": true
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "data": {
        "type": "object",
        "properties": {
